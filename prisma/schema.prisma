generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id           String        @id @default(uuid())
  firebaseId   String        @unique
  email        String        @unique
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  firstName    String?
  lastName     String?
  status       UserStatus    @default(ACTIVE)
  agentProfile AgentProfile?
  favorites    Favorite[]
  inquiries    Inquiry[]
  properties   Property[]
}

model AgentProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  agencyName String
  phone      String
  bio        String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id          String       @id @default(uuid())
  title       String
  description String
  type        PropertyType
  listingType ListingType
  price       Float
  bedrooms    Int?
  bathrooms   Int?
  size        Float?
  county      String
  lat         Float
  lng         Float
  images      String[]
  available   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agentId     String
  address     String
  subcounty   String
  favorites   Favorite[]
  inquiries   Inquiry[]
  agent       User         @relation(fields: [agentId], references: [id])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

model Inquiry {
  id         String   @id @default(uuid())
  name       String
  email      String
  message    String
  propertyId String
  userId     String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
}

enum ListingType {
  SALE
  RENT
  LISTING
}
